#!/bin/bash
# Battery safety and status (system service): below poweroff_percent while
# discharging, shut down cleanly before the battery dies under the SD card.
# Crossing warn_percent downwards sends one low-battery notification per
# discharge (the panel prints "LOW" alongside).
#
# --once            single poll, no loop (tests)
# --psu-dir DIR     scan DIR instead of /sys/class/power_supply (mock battery)
set -u

once=0
psu_dir=/sys/class/power_supply
while [[ $# -gt 0 ]]; do
    case "$1" in
        --once) once=1 ;;
        --psu-dir) psu_dir="${2:?}"; shift ;;
        *) echo "usage: ${0##*/} [--once] [--psu-dir DIR]" >&2; exit 2 ;;
    esac
    shift
done

DESKTOP_USER=user
uid="$(id -u "${DESKTOP_USER}")"
warned_file=/run/rgos-battery-warned

notify() {   # summary body icon -> desktop notification, best effort
    local bus="/run/user/${uid}/bus"
    [[ -S "${bus}" ]] || return 0
    sudo -u "${DESKTOP_USER}" DBUS_SESSION_BUS_ADDRESS="unix:path=${bus}" \
        rgos-notify -r battery -t 30000 "$@" >/dev/null 2>&1 || true
}

while :; do
    for d in "${psu_dir}"/*; do
        [[ "$(cat "${d}/type" 2>/dev/null)" == Battery ]] || continue
        pct="$(cat "${d}/capacity" 2>/dev/null)"
        status="$(cat "${d}/status" 2>/dev/null)"
        [[ "${pct}" =~ ^[0-9]+$ ]] || continue
        limit="$(rgos-power-conf poweroff_percent 3)"

        # Clean shutdown before the battery dies under the SD card
        if [[ "${status}" == Discharging && "${pct}" -le "${limit}" ]]; then
            echo "battery at ${pct}% (limit ${limit}%): powering off"
            systemctl poweroff
            exit 0
        fi

        # One low-battery warning per discharge; a charger (or a level well
        # above the threshold) re-arms it
        warn="$(rgos-power-conf warn_percent 10)"
        if [[ "${status}" == Discharging && "${pct}" -le "${warn}" ]]; then
            if [[ ! -e "${warned_file}" ]]; then
                echo "battery at ${pct}% (warn ${warn}%): sending low-battery warning"
                echo 1 >"${warned_file}" 2>/dev/null || true
                notify "Battery low" "${pct}% left — connect the charger" battery-caution
            fi
        elif [[ "${status}" != Discharging || "${pct}" -gt $((warn + 5)) ]]; then
            rm -f "${warned_file}" 2>/dev/null || true
        fi
        # Red LED policy: red means FAULT. Charging is normal operation,
        # so the status LED stays off (user rule 2026-10-12).
    done
    [[ "${once}" == 1 ]] && exit 0
    sleep 60
done
