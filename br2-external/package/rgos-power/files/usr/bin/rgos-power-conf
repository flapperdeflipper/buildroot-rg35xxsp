#!/bin/bash
# Print one setting from /etc/rgos/power.conf, overridden by
# ~/.config/rgos/power.conf:  rgos-power-conf <key> [default]
set -u
key="$1" value=""
for f in /etc/rgos/power.conf "${HOME:-/root}/.config/rgos/power.conf"; do
    [[ -r "${f}" ]] || continue
    line="$(grep -E "^[[:space:]]*${key}[[:space:]]*=" "${f}" | tail -n1)"
    [[ -n "${line}" ]] && value="$(sed -E 's/^[^=]*=[[:space:]]*//; s/[[:space:]]*(#.*)?$//' <<<"${line}")"
done
printf '%s\n' "${value:-${2:-}}"
