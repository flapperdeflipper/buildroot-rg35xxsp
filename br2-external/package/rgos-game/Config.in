config BR2_PACKAGE_RGOS_GAME
	bool "rgos-game"
	depends on BR2_PACKAGE_SYSTEMD
	select BR2_PACKAGE_RGOS_PADD
	help
	  Game/emulator launcher and system tuning: starts games in
	  games.slice with the Mesa copy-image override for the Mali-G31
	  and the pad in passthrough mode. Ships the RetroArch defaults
	  config and a menu entry when retroarch is enabled.
