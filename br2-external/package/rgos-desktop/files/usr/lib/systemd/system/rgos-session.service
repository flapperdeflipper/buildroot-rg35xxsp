[Unit]
Description=RGOS desktop session (labwc on tty1)
Documentation=https://labwc.github.io
After=systemd-user-sessions.service systemd-logind.service dbus.socket
Wants=dbus.socket systemd-logind.service
ConditionPathExists=/dev/tty1

[Service]
Type=simple
User=user
WorkingDirectory=~
PAMName=rgos-session
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland
Environment=XDG_SESSION_CLASS=user
Environment=XDG_CURRENT_DESKTOP=labwc:wlroots
Environment=LIBSEAT_BACKEND=logind
ExecStart=/usr/bin/labwc
Restart=always
RestartSec=2

[Install]
WantedBy=graphical.target
