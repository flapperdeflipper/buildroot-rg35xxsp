#!/bin/bash
# On-screen keyboard (wvkbd).
#   rgos-osk toggle     show/hide (Select on the pad, the panel's keyboard
#                       button, Super+K). Goes through rgos-padd's osk mode
#                       so the d-pad steps over the keys while it is shown.
#   rgos-osk show|hide  used by rgos-padd's osk mode hooks
#   rgos-osk start      start wvkbd hidden (session autostart)
set -u

kbd=wvkbd-mobintl

# wvkbd's debug output (-D) is the only place it reports layer switches
# ("Switching to layout landscapespecial, ..."). rgos-padd needs them to
# step over the right key grid. The rest of the debug chatter is dropped;
# errors still reach the journal.
layer_events() {
    local line
    while IFS= read -r line; do
        case "${line}" in
            "Switching to layout "*)
                line="${line#Switching to layout }"
                rgos-padctl osk_layout "${line%%,*}" ;;
            *rror*|*ailed*|*"No such"*|*annot*)
                echo "${line}" >&2 ;;
        esac
    done
}

if ! pidof -q "${kbd}"; then
    { "${kbd}" -D --hidden -L 180 --fn "DejaVu Sans 12" 2>&1 >/dev/null | layer_events; } &
    sleep 0.3
fi

case "${1:-toggle}" in
    show)
        pkill -USR2 -x "${kbd}"
        # Put the pointer on its key again once the keyboard is mapped: a
        # surface appearing under a still pointer gets no pointer focus, and
        # the first click would go to the window behind it.
        sleep 0.25
        rgos-padctl osk_park
        ;;
    hide)
        pkill -USR1 -x "${kbd}"
        ;;
    start)
        ;;
    toggle)
        rgos-padctl mode toggle-osk 2>/dev/null || kill -s RTMIN "$(pidof "${kbd}")"
        ;;
    *)
        echo "usage: rgos-osk show|hide|toggle" >&2
        exit 2
        ;;
esac
