#!/bin/bash
# Volume control for the hardware volume keys.
#   rgos-volume up|down|mute|get
# Prefers PipeWire (wpctl, default audio sink) when a server is up; falls
# back to ALSA (amixer). $RGOS_MIXER still names the ALSA control.
set -u

pw_ok() { wpctl get-volume @DEFAULT_AUDIO_SINK@ >/dev/null 2>&1; }
pw_level() { wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null | awk '{ print int($2 * 100) }'; }
pw_muted() { wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null | grep -q MUTED; }

control="${RGOS_MIXER:-}"
if [[ -z "${control}" ]]; then
    controls="$(amixer scontrols 2>/dev/null)"
    for c in Master PCM "Line Out" DAC Headphone Speaker; do
        if grep -q "'${c}'" <<<"${controls}"; then
            control="${c}"
            break
        fi
    done
fi

alsa_ok() { [[ -n "${control}" ]]; }
alsa_level() { amixer sget "${control}" | grep -o -m1 '\[[0-9]*%\]' | tr -d '[]%'; }
alsa_muted() { amixer sget "${control}" | grep -q -m1 '\[off\]'; }

level() { pw_ok && pw_level || { alsa_ok && alsa_level; }; }
muted() { pw_ok && pw_muted || { alsa_ok && alsa_muted; }; }

# On-screen feedback (one popup, updated in place)
show() {
    local v icon=audio-volume-high
    v="$(level)"
    if ! [[ "${v}" =~ ^[0-9]+$ ]]; then
        rgos-notify -r volume -t 1500 "Volume: no sound device" "" audio-volume-muted
        return
    fi
    if muted; then icon=audio-volume-muted
    elif (( v < 34 )); then icon=audio-volume-low
    elif (( v < 67 )); then icon=audio-volume-medium
    fi
    rgos-notify -r volume -t 1500 -v "${v}" "Volume $(muted && echo muted || echo "${v}%")" "" "${icon}"
}

case "${1:-get}" in
    up)   if pw_ok; then wpctl set-mute @DEFAULT_AUDIO_SINK@ 0
                 wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
          elif alsa_ok; then amixer -q sset "${control}" 5%+ unmute
          fi
          show ;;
    down) if pw_ok; then wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
          elif alsa_ok; then amixer -q sset "${control}" 5%-
          fi
          show ;;
    mute) if pw_ok; then wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
          elif alsa_ok; then amixer -q sset "${control}" toggle
          fi
          show ;;
    get)  level ;;
    *)    echo "usage: rgos-volume up|down|mute|get" >&2; exit 2 ;;
esac
