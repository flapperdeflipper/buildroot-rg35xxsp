# RGOS desktop session, started by labwc (see rgos-session.service).
# Copy to ~/.config/labwc/autostart to customise.

# Wallpaper
swaybg --mode fill --image /usr/share/rgos/wallpaper.png >/dev/null 2>&1 &

# Panel: start menu, window list, Wi-Fi, Bluetooth, volume, battery, clock
sfwbar -f /etc/rgos/sfwbar.config >/dev/null &

# Notifications (rgos-notify; SD card, ...), below the panel
mako --config /etc/rgos/mako.conf >/dev/null 2>&1 &

# Second SD card: ~/SD link + file manager bookmark (rgos-sdcard)
rgos-sdcard session &

# On-screen keyboard (hidden until SELECT / the panel's keyboard button /
# rgos-oskd opens it for a text app)
rgos-osk start &

# Phone-style OSK trigger: opens the keyboard when a text app is activated
# and no USB/BT keyboard is attached (see /etc/rgos/oskd.conf)
rgos-oskd &

# Power: performance profile, then idle dimming / screen off / auto-suspend,
# all from /etc/rgos/power.conf (see rgos-power)
rgos-power profile "$(rgos-power-conf profile balanced)" &
rgos-idle >/dev/null 2>&1 &

# Handheld buttons -> pointer/keys. Without it the pad is dead: keep it alive.
# (stderr goes to the journal: journalctl -u rgos-session)
sh -c 'while :; do rgos-padd; sleep 1; done' >/dev/null &
