# QEMU test disk: same partitions as the handheld (boot vfat + erofs root +
# overlay + data, MBR with a fixed signature) minus the SPL. bin/run-qemu
# boots the kernel directly, the boot partition just mirrors the device
# layout.

image boot.vfat {
	vfat {
		label = "RGOS-BOOT"
		files = {
#BOOT_FILES#
		}
	}
	size = 64M
}

image overlay.ext4 {
	ext4 {
		label = "rgos-overlay"
	}
	size = 2G
}

image data.ext4 {
	ext4 {
		label = "rgos-data"
	}
	size = 512M
}

image #IMAGE_NAME# {
	hdimage {
		partition-table-type = "mbr"
		disk-signature = #DISK_SIGNATURE#
	}

	partition boot {
		partition-type = 0xC
		bootable = true
		image = "boot.vfat"
		offset = 4M
	}

	partition rootfs {
		partition-type = 0x83
		image = "rootfs.erofs"
	}

	partition overlay {
		partition-type = 0x83
		image = "overlay.ext4"
	}

	partition data {
		partition-type = 0x83
		image = "data.ext4"
	}
}
