# Kernel config for Allwinner H700 handhelds. Applied after
# boards/common/linux.fragment.
#
# Drivers that need firmware from /lib/firmware (panel init sequence, GPU,
# WiFi, BT) are modules: we boot without an initramfs, so they must load
# after the rootfs is mounted.

# Only build Allwinner platform support (shrinks the defconfig considerably)
# CONFIG_ARCH_ACTIONS is not set
# CONFIG_ARCH_AIROHA is not set
# CONFIG_ARCH_ALPINE is not set
# CONFIG_ARCH_APPLE is not set
# CONFIG_ARCH_ARTPEC is not set
# CONFIG_ARCH_ASPEED is not set
# CONFIG_ARCH_AXIADO is not set
# CONFIG_ARCH_BCM2835 is not set
# CONFIG_ARCH_BCM_IPROC is not set
# CONFIG_ARCH_BCMBCA is not set
# CONFIG_ARCH_BRCMSTB is not set
# CONFIG_ARCH_BERLIN is not set
# CONFIG_ARCH_BITMAIN is not set
# CONFIG_ARCH_BLAIZE is not set
# CONFIG_ARCH_BST is not set
# CONFIG_ARCH_CIX is not set
# CONFIG_ARCH_EXYNOS is not set
# CONFIG_ARCH_K3 is not set
# CONFIG_ARCH_LG1K is not set
# CONFIG_ARCH_HISI is not set
# CONFIG_ARCH_KEEMBAY is not set
# CONFIG_ARCH_MEDIATEK is not set
# CONFIG_ARCH_MESON is not set
# CONFIG_ARCH_LAN969X is not set
# CONFIG_ARCH_SPARX5 is not set
# CONFIG_ARCH_MMP is not set
# CONFIG_ARCH_MVEBU is not set
# CONFIG_ARCH_LAYERSCAPE is not set
# CONFIG_ARCH_MXC is not set
# CONFIG_ARCH_S32 is not set
# CONFIG_ARCH_MA35 is not set
# CONFIG_ARCH_NPCM is not set
# CONFIG_ARCH_PENSANDO is not set
# CONFIG_ARCH_QCOM is not set
# CONFIG_ARCH_REALTEK is not set
# CONFIG_ARCH_RENESAS is not set
# CONFIG_ARCH_ROCKCHIP is not set
# CONFIG_ARCH_SEATTLE is not set
# CONFIG_ARCH_INTEL_SOCFPGA is not set
# CONFIG_ARCH_SOPHGO is not set
# CONFIG_ARCH_STM32 is not set
# CONFIG_ARCH_SYNQUACER is not set
# CONFIG_ARCH_TEGRA is not set
# CONFIG_ARCH_TESLA_FSD is not set
# CONFIG_ARCH_SPRD is not set
# CONFIG_ARCH_THUNDER is not set
# CONFIG_ARCH_THUNDER2 is not set
# CONFIG_ARCH_UNIPHIER is not set
# CONFIG_ARCH_VEXPRESS is not set
# CONFIG_ARCH_VISCONTI is not set
# CONFIG_ARCH_XGENE is not set
# CONFIG_ARCH_ZYNQMP is not set
CONFIG_ARCH_SUNXI=y
# CONFIG_PCI is not set
# CONFIG_VIRTUALIZATION is not set

# Clocks, power, PMIC (AXP717), thermal, cpufreq
CONFIG_SUN50I_H616_CCU=y
CONFIG_SUN8I_DE2_CCU=y
CONFIG_SUNXI_RSB=y
CONFIG_MFD_AXP20X=y
CONFIG_MFD_AXP20X_I2C=y
CONFIG_REGULATOR_AXP20X=y
CONFIG_AXP20X_ADC=y
CONFIG_AXP20X_POWER=y
CONFIG_BATTERY_AXP20X=y
CONFIG_CHARGER_AXP20X=y
CONFIG_INPUT_AXP20X_PEK=y
CONFIG_SUN8I_THERMAL=y
CONFIG_CPUFREQ_DT=y
CONFIG_ARM_ALLWINNER_SUN50I_CPUFREQ_NVMEM=y
CONFIG_NVMEM_SUNXI_SID=y
CONFIG_SUNXI_WATCHDOG=y
CONFIG_RTC_DRV_SUN6I=y
CONFIG_RTC_DRV_PCF8563=y
CONFIG_DMA_SUN6I=y
CONFIG_SUN50I_IOMMU=y
# GPU power domain (gpu@1800000 has power-domains = <&prcm_ppu 2>); without
# it panfrost defers forever and gives up
CONFIG_SUN50I_H6_PRCM_PPU=y
CONFIG_I2C_MV64XXX=y
CONFIG_SPI_SUN6I=y
CONFIG_SPI_GPIO=y
CONFIG_MMC_SUNXI=y

# The WiFi SDIO pwrseq has reset-gpios but no resets property; with
# CONFIG_RESET_GPIO enabled the reset core's GPIO fallback rejects the
# 3-cell sunxi GPIO spec (-ENOENT), pwrseq-simple fails to probe, the WiFi
# mmc host defers forever and WiFi/BT never come up. Nothing on this board
# uses the reset-gpio framework.
# CONFIG_RESET_GPIO is not set

# Display: DE33 mixer + TCON (patched), RGB panel over SPI-init, PWM backlight.
# The sun4i DRM pieces must be built in: the ROCKNIX patches call between
# them without exporting symbols (as in ROCKNIX's own config). The panel
# driver stays a module: it reads its init sequence from /lib/firmware.
CONFIG_DRM_SUN4I=y
CONFIG_DRM_SUN8I_MIXER=y
CONFIG_DRM_SUN8I_TCON_TOP=y
CONFIG_DRM_SUN8I_DW_HDMI=y
CONFIG_DRM_PANEL_MIPI=m
CONFIG_DRM_PANFROST=m
CONFIG_PWM=y
CONFIG_PWM_SUN8I=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=y
CONFIG_PHY_SUN6I_MIPI_DPHY=y

# Video decode (cedrus), for the media phase
CONFIG_MEDIA_SUPPORT=m
CONFIG_STAGING=y
CONFIG_STAGING_MEDIA=y
CONFIG_VIDEO_SUNXI=y
CONFIG_VIDEO_SUNXI_CEDRUS=m

# Audio: internal codec + HDMI
CONFIG_SND_SUN4I_CODEC=m
CONFIG_SND_SUN4I_I2S=m
CONFIG_SND_SOC_HDMI_CODEC=m

# Buttons, lid, LEDs
CONFIG_KEYBOARD_GPIO=y
CONFIG_KEYBOARD_GPIO_POLLED=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_CLASS_MULTICOLOR=y
CONFIG_LEDS_GPIO=y
CONFIG_LEDS_PWM=y
CONFIG_LEDS_SUN50I_A100=m
CONFIG_LEDS_TRIGGER_DEFAULT_ON=y
CONFIG_LEDS_TRIGGER_HEARTBEAT=y

# USB-C OTG (musb) + EHCI/OHCI. Built-in musb in dual-role mode needs the
# gadget core and the NOP transceiver built in as well.
CONFIG_USB_GADGET=y
CONFIG_NOP_USB_XCEIV=y
CONFIG_EXTCON=y
CONFIG_USB_OTG=y
CONFIG_USB_MUSB_HDRC=y
CONFIG_USB_MUSB_SUNXI=y
CONFIG_USB_MUSB_DUAL_ROLE=y
CONFIG_PHY_SUN4I_USB=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_HCD_PLATFORM=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PLATFORM=y

# WiFi: RTL8821CS on SDIO (rtw88)
CONFIG_RTW88=m
CONFIG_RTW88_8821CS=m

# Bluetooth: RTL8821CS on UART (hci_uart 3-wire/H5 + rtl)
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_SERDEV=y
CONFIG_BT_HCIUART_3WIRE=y
CONFIG_BT_HCIUART_RTL=y
CONFIG_BT_RTL=m
