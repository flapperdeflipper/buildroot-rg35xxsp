# Kernel config shared by all RGOS boards, applied on top of the arm64
# defconfig, before the board fragment.

# Boot / misc
CONFIG_LOCALVERSION="-rgos"
# 300 Hz (vs the 250 Hz default): slightly better interactive latency at a
# small idle-wakeup cost.
# CONFIG_HZ_250 is not set
CONFIG_HZ_300=y
CONFIG_HZ=300
# Boot fast on the performance governor; labwc autostart applies the
# configured power profile (schedutil) when the session starts.
# CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL is not set
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
# MGLRU: better page reclaim under memory pressure on 1 GB (LRU_GEN is
# built by default but inactive without _ENABLED).
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
# Allocator hardening off for a little boot/allocation speed.
# CONFIG_SLAB_FREELIST_RANDOM is not set
# CONFIG_SHUFFLE_PAGE_ALLOCATOR is not set
# zram: fast primary (lzo-rle, cheap on the A53) with zstd recompression of
# idle huge pages (ZRAM_MULTI_COMP); the zstd backend also stays available.
CONFIG_ZRAM=m
CONFIG_ZRAM_BACKEND_LZO=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_DEF_COMP_LZORLE=y
CONFIG_ZRAM_MULTI_COMP=y
CONFIG_CRYPTO_ZSTD=y
CONFIG_PSI=y

# Filesystems
CONFIG_EXT4_FS=y
# Read-only root: erofs (p2) + overlayfs (upper on p3) + initramfs boot
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_OVERLAY_FS=y
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=y
CONFIG_FAT_DEFAULT_UTF8=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y

# Display console
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER=y

# Input: uinput (pad daemon), joysticks, HID for USB/BT keyboards and mice
CONFIG_INPUT_UINPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_JOYDEV=m
CONFIG_INPUT_JOYSTICK=y
CONFIG_JOYSTICK_XPAD=m
CONFIG_JOYSTICK_XPAD_FF=y
CONFIG_INPUT_FF_MEMLESS=m
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_HID_MULTITOUCH=m
CONFIG_HID_PLAYSTATION=m
CONFIG_HID_NINTENDO=m
CONFIG_HID_SONY=m
CONFIG_HID_MICROSOFT=m
CONFIG_HID_LOGITECH=m
CONFIG_HID_LOGITECH_DJ=m
CONFIG_HID_APPLE=m
CONFIG_UHID=m
CONFIG_HIDRAW=y
CONFIG_USB_HID=y

# USB host: storage, serial adapters, ethernet/tethering, audio, gadget
CONFIG_USB=y
CONFIG_USB_STORAGE=m
CONFIG_USB_UAS=m
CONFIG_USB_SERIAL=m
CONFIG_USB_SERIAL_FTDI_SIO=m
CONFIG_USB_SERIAL_CP210X=m
CONFIG_USB_SERIAL_CH341=m
CONFIG_USB_ACM=m
CONFIG_USB_NET_DRIVERS=m
CONFIG_USB_USBNET=m
CONFIG_USB_NET_CDCETHER=m
CONFIG_USB_NET_CDC_NCM=m
CONFIG_USB_NET_AX88179_178A=m
CONFIG_USB_RTL8152=m
CONFIG_SND_USB_AUDIO=m
CONFIG_USB_GADGET=m
CONFIG_USB_CONFIGFS=m
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y

# Bluetooth (HID profiles for keyboards, mice, controllers)
CONFIG_BT=m
CONFIG_BT_HIDP=m
CONFIG_BT_RFCOMM=m
CONFIG_BT_BNEP=m

# WiFi stack
CONFIG_CFG80211=m
CONFIG_MAC80211=m

# SDR dongles (RTL2832U) are driven from userspace by librtlsdr;
# keep the DVB driver from grabbing them.
# CONFIG_DVB_USB_RTL28XXU is not set
