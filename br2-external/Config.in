menu "RGOS"
	comment "Board support"
	config BR2_RGOS_LINUX_H700_PATCHES
		bool "Apply the H700 kernel patch set"
		depends on BR2_LINUX_KERNEL
		help
		  Download the Allwinner H700 kernel patches (display engine,
		  panel, backlight, OTG, ...) from the pinned upstream commit
		  (RGOS_ROCKNIX_COMMIT in external.mk) and apply them to the
		  kernel.

	source "$BR2_EXTERNAL_RGOS_PATH/package/rgos-panel-firmware/Config.in"
	source "$BR2_EXTERNAL_RGOS_PATH/package/rgos-uboot-ddr3/Config.in"
	source "$BR2_EXTERNAL_RGOS_PATH/package/rgos-suspend-stub/Config.in"
	source "$BR2_EXTERNAL_RGOS_PATH/package/rgos-padsim/Config.in"

	comment "Desktop"
	source "$BR2_EXTERNAL_RGOS_PATH/package/rgos-desktop/Config.in"
	source "$BR2_EXTERNAL_RGOS_PATH/package/rgos-padd/Config.in"
	source "$BR2_EXTERNAL_RGOS_PATH/package/rgos-oskd/Config.in"
	source "$BR2_EXTERNAL_RGOS_PATH/package/labwc/Config.in"
	source "$BR2_EXTERNAL_RGOS_PATH/package/gtk-layer-shell/Config.in"
	source "$BR2_EXTERNAL_RGOS_PATH/package/sfwbar/Config.in"
	source "$BR2_EXTERNAL_RGOS_PATH/package/wlopm/Config.in"
	source "$BR2_EXTERNAL_RGOS_PATH/package/rgos-power/Config.in"
	source "$BR2_EXTERNAL_RGOS_PATH/package/swayidle/Config.in"
	source "$BR2_EXTERNAL_RGOS_PATH/package/fuzzel/Config.in"
	source "$BR2_EXTERNAL_RGOS_PATH/package/wvkbd/Config.in"
	source "$BR2_EXTERNAL_RGOS_PATH/package/mako/Config.in"
	source "$BR2_EXTERNAL_RGOS_PATH/package/rgos-sdcard/Config.in"

	comment "Apps"
	source "$BR2_EXTERNAL_RGOS_PATH/package/gtksourceview4/Config.in"
	source "$BR2_EXTERNAL_RGOS_PATH/package/mousepad/Config.in"
	source "$BR2_EXTERNAL_RGOS_PATH/package/geany/Config.in"
 	source "$BR2_EXTERNAL_RGOS_PATH/package/weechat/Config.in"
 	source "$BR2_EXTERNAL_RGOS_PATH/package/srain/Config.in"
	source "$BR2_EXTERNAL_RGOS_PATH/package/yt-dlp/Config.in"
	source "$BR2_EXTERNAL_RGOS_PATH/package/rgos-youtube/Config.in"
	source "$BR2_EXTERNAL_RGOS_PATH/package/btop/Config.in"
	source "$BR2_EXTERNAL_RGOS_PATH/package/fzf/Config.in"
	source "$BR2_EXTERNAL_RGOS_PATH/package/glow/Config.in"
	source "$BR2_EXTERNAL_RGOS_PATH/package/progress/Config.in"
	source "$BR2_EXTERNAL_RGOS_PATH/package/prettyping/Config.in"
	source "$BR2_EXTERNAL_RGOS_PATH/package/syncthing/Config.in"
	source "$BR2_EXTERNAL_RGOS_PATH/package/rockbox/Config.in"
	source "$BR2_EXTERNAL_RGOS_PATH/package/rgos-web/Config.in"
endmenu
