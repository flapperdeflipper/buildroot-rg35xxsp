# Anbernic RG35XX SP (Allwinner H700, 1GB, 640x480 RGB panel, RTL8821CS)
# Appended after rgos_common_defconfig by build-image.sh.

BR2_cortex_a53=y

# Kernel — Linux 7.2 + the H700 patch set (display engine DE33, panel, PWM
# backlight, OTG, suspend fixes), fetched at build time from a pinned
# upstream commit and applied by external.mk.
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="https://cdn.kernel.org/pub/linux/kernel/v7.x/linux-7.2.tar.xz"
BR2_LINUX_KERNEL_PATCH="$(BR2_EXTERNAL_RGOS_PATH)/boards/h700/linux-patches"
BR2_RGOS_LINUX_H700_PATCHES=y
BR2_LINUX_KERNEL_USE_ARCH_DEFAULT_CONFIG=y
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_RGOS_PATH)/boards/common/linux.fragment $(BR2_EXTERNAL_RGOS_PATH)/boards/h700/linux.fragment $(BR2_EXTERNAL_RGOS_PATH)/boards/h700/linux-trim.fragment"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="allwinner/sun50i-h700-anbernic-rg35xx-sp allwinner/sun50i-h700-anbernic-rg35xx-2024 allwinner/sun50i-h700-anbernic-rg35xx-plus allwinner/sun50i-h700-anbernic-rg35xx-h"
BR2_LINUX_KERNEL_CUSTOM_DTS_PATH="$(BR2_EXTERNAL_RGOS_PATH)/boards/h700/dts/sun50i-h700-anbernic-rg35xx-sp-v2-panel.dts"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_LINUX_KERNEL_INSTALL_TARGET=y

# Graphics: Mali-G31 via Panfrost (fully open)
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_PANFROST=y

# Firmware: RTL8821CS WiFi (rtw88) + Bluetooth, panel init sequences
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_RTW88=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_88XX_BT=y
BR2_PACKAGE_RGOS_BT_FIRMWARE=y
BR2_PACKAGE_RGOS_PANEL_FIRMWARE=y

# TF-A (BL31) + mainline U-Boot (LPDDR4 variant)
BR2_TARGET_ARM_TRUSTED_FIRMWARE=y
BR2_TARGET_ARM_TRUSTED_FIRMWARE_LATEST_VERSION=y
BR2_TARGET_ARM_TRUSTED_FIRMWARE_PLATFORM="sun50i_h616"
BR2_TARGET_UBOOT=y
BR2_TARGET_UBOOT_BUILD_SYSTEM_KCONFIG=y
BR2_TARGET_UBOOT_LATEST_VERSION=y
BR2_TARGET_UBOOT_BOARD_DEFCONFIG="anbernic_rg35xx_h700"
BR2_TARGET_UBOOT_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_RGOS_PATH)/boards/h700/uboot.fragment"
BR2_TARGET_UBOOT_NEEDS_DTC=y
BR2_TARGET_UBOOT_NEEDS_PYLIBFDT=y
BR2_TARGET_UBOOT_NEEDS_PYELFTOOLS=y
BR2_TARGET_UBOOT_NEEDS_OPENSSL=y
BR2_TARGET_UBOOT_NEEDS_GNUTLS=y
BR2_TARGET_UBOOT_NEEDS_ATF_BL31=y
BR2_TARGET_UBOOT_SPL=y
BR2_TARGET_UBOOT_SPL_NAME="u-boot-sunxi-with-spl.bin"
BR2_TARGET_UBOOT_CUSTOM_MAKEOPTS="SCP=/dev/null"

# Second U-Boot build for units with LPDDR3 memory (same source, other DRAM params)
BR2_PACKAGE_RGOS_UBOOT_DDR3=y
# H700 deep sleep: SRAM suspend stubs + patched TF-A (PSCI SYSTEM_SUSPEND)
BR2_PACKAGE_RGOS_SUSPEND_STUB=y

# H700-specific rootfs files (panel module loading)
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_RGOS_PATH)/rootfs_overlay $(BR2_EXTERNAL_RGOS_PATH)/boards/h700/rootfs_overlay"

# Image layout + post-image args (board dir)
BR2_ROOTFS_POST_SCRIPT_ARGS="$(BR2_EXTERNAL_RGOS_PATH)/boards/h700 rg35xxsp"
BR2_TARGET_GENERIC_GETTY_PORT="ttyS0"
