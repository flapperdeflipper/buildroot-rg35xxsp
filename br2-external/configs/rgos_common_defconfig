# RGOS common base — shared by all boards.
# Board specifics (kernel, bootloader, DTBs, image layout) live in the board
# defconfig, which build-image.sh appends after this file (last value wins).

# Architecture — every supported board is aarch64; CPU set per board
BR2_aarch64=y

# Toolchain
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_KERNEL_HEADERS_7_1=y

# Build: per-package directories allow building packages in parallel
# (build-image.sh runs make with a top-level -j)
BR2_PER_PACKAGE_DIRECTORIES=y
BR2_CCACHE=y
BR2_CCACHE_DIR="$(HOME)/.ccache"
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_RGOS_PATH)/patches"

# System
BR2_TARGET_GENERIC_HOSTNAME="rgos"
BR2_TARGET_GENERIC_ISSUE="RGOS"
BR2_INIT_SYSTEMD=y
BR2_SYSTEM_BIN_SH_BASH=y
BR2_ROOTFS_MERGED_USR=y
BR2_TARGET_GENERIC_ROOT_PASSWD=""
BR2_SYSTEM_ENABLE_NLS=y
BR2_GENERATE_LOCALE="en_US.UTF-8"
BR2_TARGET_LOCALTIME="Europe/Amsterdam"
BR2_ROOTFS_USERS_TABLES="$(BR2_EXTERNAL_RGOS_PATH)/users.txt"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_RGOS_PATH)/rootfs_overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_RGOS_PATH)/boards/scripts/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_RGOS_PATH)/boards/scripts/post-image.sh"

# systemd
BR2_PACKAGE_SYSTEMD_LOGIND=y
BR2_PACKAGE_SYSTEMD_NETWORKD=y
BR2_PACKAGE_SYSTEMD_RESOLVED=y
BR2_PACKAGE_SYSTEMD_TIMESYNCD=y
BR2_PACKAGE_SYSTEMD_HOSTNAMED=y
BR2_PACKAGE_SYSTEMD_BACKLIGHT=y
BR2_PACKAGE_SYSTEMD_UTMP=y
BR2_PACKAGE_SYSTEMD_SYSUSERS=y
BR2_PACKAGE_SYSTEMD_COREDUMP=y
BR2_PACKAGE_LINUX_PAM=y
BR2_PACKAGE_DBUS=y
BR2_PACKAGE_DBUS_BROKER=y

# Base utilities
BR2_PACKAGE_BASH_COMPLETION=y
BR2_PACKAGE_COREUTILS=y
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
BR2_PACKAGE_UTIL_LINUX_PARTX=y
BR2_PACKAGE_UTIL_LINUX_RFKILL=y
BR2_PACKAGE_UTIL_LINUX_ZRAMCTL=y
BR2_PACKAGE_PROCPS_NG=y
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_E2FSPROGS_RESIZE2FS=y
BR2_PACKAGE_DOSFSTOOLS=y
BR2_PACKAGE_DOSFSTOOLS_FSCK_FAT=y
BR2_PACKAGE_EXFATPROGS=y
BR2_PACKAGE_KMOD_TOOLS=y
BR2_PACKAGE_SUDO=y
BR2_PACKAGE_SHADOW=y
BR2_PACKAGE_LESS=y
BR2_PACKAGE_FILE=y
BR2_PACKAGE_WHICH=y
BR2_PACKAGE_FINDUTILS=y
BR2_PACKAGE_GREP=y
BR2_PACKAGE_SED=y
BR2_PACKAGE_GAWK=y
BR2_PACKAGE_TAR=y
BR2_PACKAGE_GZIP=y
BR2_PACKAGE_XZ=y
BR2_PACKAGE_ZSTD=y
BR2_PACKAGE_UNZIP=y
BR2_PACKAGE_HTOP=y
BR2_PACKAGE_TMUX=y
BR2_PACKAGE_VIM=y
BR2_PACKAGE_NANO=y
BR2_PACKAGE_JQ=y
BR2_PACKAGE_RSYNC=y
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_LIBCURL_CURL=y
BR2_PACKAGE_WGET=y
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_EVTEST=y
BR2_PACKAGE_I2C_TOOLS=y
BR2_PACKAGE_USBUTILS=y

# Networking
BR2_PACKAGE_IWD=y
BR2_PACKAGE_WIRELESS_REGDB=y
BR2_PACKAGE_IW=y
BR2_PACKAGE_OPENSSH=y
BR2_PACKAGE_IPROUTE2=y
BR2_PACKAGE_BLUEZ5_UTILS=y
BR2_PACKAGE_BLUEZ5_UTILS_CLIENT=y
BR2_PACKAGE_BLUEZ5_UTILS_PLUGINS_HID=y
BR2_PACKAGE_BLUEZ5_UTILS_PLUGINS_AUDIO=y

# Audio: PipeWire + WirePlumber (user services in the desktop session,
# enabled via /etc/systemd/user/default.target.wants), with the Pulse
# compatibility socket for SDL/mpv. alsa-utils stays: amixer fallback
# (rgos-volume), alsamixer, aplay, speaker-test.
BR2_PACKAGE_PIPEWIRE=y
BR2_PACKAGE_WIREPLUMBER=y
BR2_PACKAGE_LUA=y
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_AMIXER=y
BR2_PACKAGE_ALSA_UTILS_ALSAMIXER=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y
BR2_PACKAGE_ALSA_UTILS_SPEAKER_TEST=y

# Graphics: Mesa (gallium driver chosen per board). No target LLVM by
# default: Panfrost's shader precompiler runs on the build host
# (buildroot-patches/0002). Boards using llvmpipe enable MESA3D_LLVM.
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
BR2_PACKAGE_MESA3D_GBM=y
BR2_PACKAGE_KMSCUBE=y
BR2_PACKAGE_LIBDRM=y

# X11 client libraries (no X server): needed by GTK3's X11 backend for
# PCManFM/libfm, and lets X11 apps run under Xwayland
BR2_PACKAGE_XORG7=y
BR2_PACKAGE_MESA3D_OPENGL_GLX=y
BR2_PACKAGE_WLROOTS=y
BR2_PACKAGE_WLROOTS_XWAYLAND=y

# GTK3 (Wayland + X11 backends) and icon themes
BR2_PACKAGE_LIBGTK3=y
BR2_PACKAGE_LIBGTK3_WAYLAND=y
BR2_PACKAGE_LIBGTK3_X11=y
BR2_PACKAGE_ADWAITA_ICON_THEME=y
BR2_PACKAGE_HICOLOR_ICON_THEME=y

# Desktop, Raspberry Pi OS style: labwc (stacking windows) + sfwbar panel +
# swaybg wallpaper; apps: foot (terminal), Mousepad (notes), PCManFM (files).
# See package/rgos-desktop.
BR2_PACKAGE_RGOS_DESKTOP=y
# Power management: idle/sleep/radios/profiles/battery guard (rgos-power)
BR2_PACKAGE_RGOS_POWER=y
BR2_PACKAGE_RGOS_SDCARD=y
BR2_PACKAGE_MAKO=y
BR2_PACKAGE_PCMANFM=y
BR2_PACKAGE_MOUSEPAD=y

# Fonts
BR2_PACKAGE_DEJAVU=y

# Filesystem image: read-only erofs root (p2), overlaid at boot with the
# rgos-overlay partition (p3); /data (p4) is grown on first boot.
# BR2_TARGET_ROOTFS_EROFS_SIZE is auto (fits contents, padded to 4 KiB).
BR2_TARGET_ROOTFS_EROFS=y
BR2_TARGET_ROOTFS_EROFS_LZ4HC=y
# BR2_TARGET_ROOTFS_TAR is not set

# Host tools for image assembly
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_MTOOLS=y
BR2_PACKAGE_HOST_UBOOT_TOOLS=y

# Apps (phase 2) -------------------------------------------------
# Prebuilt host toolchains for the Rust and Go tools (no compiler bootstrap)
BR2_PACKAGE_HOST_RUSTC=y
BR2_PACKAGE_HOST_RUST_BIN=y
BR2_PACKAGE_HOST_GO=y
BR2_PACKAGE_HOST_GO_BIN=y
# Wide-character (UTF-8) ncurses: mc, WeeChat, htop box drawing
BR2_PACKAGE_NCURSES=y
BR2_PACKAGE_NCURSES_WCHAR=y
# CLI: search, files, text
BR2_PACKAGE_RIPGREP=y
BR2_PACKAGE_FD=y
BR2_PACKAGE_BAT=y
BR2_PACKAGE_ZOXIDE=y
BR2_PACKAGE_TEALDEER=y
BR2_PACKAGE_TREE=y
BR2_PACKAGE_NCDU=y
BR2_PACKAGE_MC=y
BR2_PACKAGE_YQ=y
BR2_PACKAGE_P7ZIP=y
BR2_PACKAGE_P7ZIP_7ZA=y
BR2_PACKAGE_ZIP=y
BR2_PACKAGE_SQLITE=y
# CLI: debugging and network
BR2_PACKAGE_LSOF=y
BR2_PACKAGE_STRACE=y
BR2_PACKAGE_TCPDUMP=y
BR2_PACKAGE_IPERF3=y
BR2_PACKAGE_MTR=y
BR2_PACKAGE_NMAP=y
BR2_PACKAGE_NMAP_NMAP=y
BR2_PACKAGE_NGREP=y
BR2_PACKAGE_NETCAT_OPENBSD=y
BR2_PACKAGE_MINICOM=y
# CLI: development
BR2_PACKAGE_GIT=y
BR2_PACKAGE_GNUPG2=y
BR2_PACKAGE_PYTHON3=y
BR2_PACKAGE_PYTHON3_SSL=y
BR2_PACKAGE_PYTHON3_SQLITE=y
BR2_PACKAGE_PYTHON3_READLINE=y
BR2_PACKAGE_PYTHON3_CURSES=y
BR2_PACKAGE_PYTHON3_UNICODEDATA=y
BR2_PACKAGE_PYTHON3_ZLIB=y
BR2_PACKAGE_PYTHON3_BZIP2=y
BR2_PACKAGE_PYTHON3_XZ=y
BR2_PACKAGE_PYTHON3_PYEXPAT=y
# Video player (also used by the YouTube app)
BR2_PACKAGE_FFMPEG=y
BR2_PACKAGE_FFMPEG_GPL=y
BR2_PACKAGE_FFMPEG_SWSCALE=y
# AV1 decode: YouTube serves some videos AV1-only
BR2_PACKAGE_DAV1D=y
BR2_PACKAGE_MPV=y
# Web browser (light)
BR2_PACKAGE_NETSURF=y
BR2_PACKAGE_NETSURF_GTK3=y
# Own packages (br2-external/package)
BR2_PACKAGE_GEANY=y
BR2_PACKAGE_WEECHAT=y
# IRC with a GUI (WeeChat stays: IRC in the terminal)
BR2_PACKAGE_SRAIN=y
BR2_PACKAGE_YT_DLP=y
BR2_PACKAGE_RGOS_YOUTUBE=y
BR2_PACKAGE_BTOP=y
BR2_PACKAGE_FZF=y
BR2_PACKAGE_GLOW=y
BR2_PACKAGE_PROGRESS=y
BR2_PACKAGE_PRETTYPING=y
# Character-set converters (glibc iconv): NetSurf, Python codecs, mail/IRC.
# Western + Unicode only; the full set is ~8.7 MB.
BR2_TOOLCHAIN_GLIBC_GCONV_LIBS_COPY=y
BR2_TOOLCHAIN_GLIBC_GCONV_LIBS_LIST="ISO8859-1 ISO8859-2 ISO8859-15 CP1250 CP1251 CP1252 IBM437 IBM850 KOI8-R UTF-16 UTF-32 UTF-7 UNICODE"
# SDL2 (Rockbox, games): Wayland in the desktop, KMS/DRM full screen
BR2_PACKAGE_SDL2=y
BR2_PACKAGE_SDL2_WAYLAND=y
BR2_PACKAGE_SDL2_KMSDRM=y
BR2_PACKAGE_SDL2_OPENGLES=y
BR2_PACKAGE_ROCKBOX=y

# Emulators (RetroArch + first core set) and the game launcher with the
# games/background slices; see docs/apps.md. Cores: GB/GBC (gambatte),
# GBA (mGBA), NES (nestopia), SNES (snes9x), MD/SMS/GG (Genesis-Plus-GX).
BR2_PACKAGE_RGOS_GAME=y
BR2_PACKAGE_RETROARCH=y
BR2_PACKAGE_LIBRETRO_GAMBATTE=y
BR2_PACKAGE_LIBRETRO_MGBA=y
BR2_PACKAGE_LIBRETRO_NESTOPIA=y
BR2_PACKAGE_LIBRETRO_SNES9X=y
BR2_PACKAGE_LIBRETRO_GENESIS_PLUS_GX=y

# File sync as a session user service; DISABLED by default (enable with
# "systemctl --user enable --now syncthing" or the services menu).
BR2_PACKAGE_SYNCTHING=y
# SDR (RTL2832U dongles; the kernel keeps its DVB driver off them):
# rtl_* tools, rtl_433 (433/868 MHz sensors), dump1090 (ADS-B), SoapySDR
BR2_PACKAGE_LIBRTLSDR=y
BR2_PACKAGE_LIBRTLSDR_DETACH_DRIVER=y
BR2_PACKAGE_RTL_433=y
BR2_PACKAGE_DUMP1090=y
BR2_PACKAGE_SOAPY_SDR=y
BR2_PACKAGE_SOAPY_SDR_APPS=y
