# <file system>   <mount pt>  <type>  <options>                                        <dump> <pass>
LABEL=RGOS-BOOT   /boot       vfat    noatime,nofail,umask=0022,x-systemd.automount    0      2
# The root filesystem comes up in early userspace (initramfs): read-only
# erofs (p2) with the rgos-overlay partition (p3) as the overlayfs upper,
# /data (p4) mounted at /data, /home bound from /data/home.
