#!/bin/bash
# Grow the root partition and its ext4 filesystem to fill the SD card.
# Runs once on first boot (rgos-growfs.service).
set -e -u -o pipefail

root_dev="$(findmnt -n -o SOURCE /)"
part="$(basename "${root_dev}")"
disk="$(basename "$(readlink -f "/sys/class/block/${part}/..")")"
partnum="$(cat "/sys/class/block/${part}/partition")"

echo "Growing /dev/${disk} partition ${partnum} (${root_dev}) to the end of the card"
echo ",+" | sfdisk --no-reread --no-tell-kernel -N "${partnum}" "/dev/${disk}"
partx -u -n "${partnum}" "/dev/${disk}"
resize2fs "${root_dev}"

mkdir -p /var/lib/rgos
touch /var/lib/rgos/growfs.done
