[Unit]
Description=Recompress idle zram pages with zstd
ConditionPathExists=/sys/block/zram0/recompress
After=rgos-zram.service

[Service]
Type=oneshot
# Mark pages idle (>= 5 min old when the kernel supports the age argument),
# then recompress the big idle ones with zstd. Already-recompressed pages
# are skipped by the kernel.
ExecStart=/bin/sh -c 'echo 300 > /sys/block/zram0/idle 2>/dev/null || echo 1 > /sys/block/zram0/idle; echo "algo=zstd type=huge_idle" > /sys/block/zram0/recompress 2>/dev/null || true'
