# Services enabled on RGOS (systemctl preset-all runs at image build time)
enable rgos-growdata.service
enable rgos-zram.service
enable rgos-zram-recompress.timer
enable rgos-session.service
enable systemd-networkd.service
enable systemd-resolved.service
enable systemd-timesyncd.service
enable iwd.service
enable bluetooth.service
enable sshd.service
enable rgos-bootlog.service
enable rgos-bootconfig.service
