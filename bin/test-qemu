#!/usr/bin/env bash
# vi: ft=bash
# shellcheck shell=bash
#
# Smoke-test the QEMU image: boot headless from a fresh disk, then check the
# system and the desktop over SSH while pressing simulated pad buttons.
#
# Usage:
#   bin/test-qemu [--keep]     --keep: leave the VM running afterwards
#
# Runs in its own QEMU instance (tmp/qemu-N, SSH port 2222+N, first free
# N >= 1; RGOS_QEMU_INSTANCE=N forces one), so several test runs and an
# interactive bin/run-qemu (instance 0) can run side by side.
# Screenshots of each step: <instance dir>/test-*.png, serial log there too.
#
set -u -o pipefail

BASEDIR="$(cd "$(dirname "${0}")/.." && pwd)"
# shellcheck source=lib/common.sh
source "${BASEDIR}/bin/lib/common.sh"

# Pick and claim a free instance (or the one asked for)
# shellcheck source=lib/qemu.sh
if [[ -n "${RGOS_QEMU_INSTANCE:-}" ]]; then
    source "${BASEDIR}/bin/lib/qemu.sh"
    qemu_claim || { log_err "QEMU instance ${RGOS_QEMU_INSTANCE} is busy"; exit 1; }
    [[ -z "$(qemu_running_pid)" ]] || { qemu_release; log_err "QEMU instance ${RGOS_QEMU_INSTANCE} has a VM running"; exit 1; }
else
    for n in $(seq 1 9); do
        RGOS_QEMU_INSTANCE="${n}"
        source "${BASEDIR}/bin/lib/qemu.sh"
        if qemu_claim; then
            [[ -z "$(qemu_running_pid)" ]] && break
            qemu_release
        fi
        [[ "${n}" -eq 9 ]] && { log_err "No free QEMU instance (1-9)"; exit 1; }
    done
fi
export RGOS_QEMU_INSTANCE RGOS_QEMU_CLAIMED=1
STATE="${QEMU_STATE}"
log "QEMU instance ${QEMU_INSTANCE}: ${STATE}, SSH port ${QEMU_SSH_PORT}"
KEEP=0
[[ "${1:-}" == "--keep" ]] && KEEP=1

SSH=(ssh -F /dev/null -i "${BASEDIR}/.ssh/builder" -o IdentitiesOnly=yes -o IdentityAgent=none
     -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR
     -o ConnectTimeout=5 -o BatchMode=yes -p "${QEMU_SSH_PORT}" user@127.0.0.1)
PASS=0 FAIL=0
FAILED=()

function vm() { "${SSH[@]}" "${@}"; }

# Run a command inside the desktop session's environment (Wayland socket)
function gui() {
    vm "export XDG_RUNTIME_DIR=/run/user/1000; export WAYLAND_DISPLAY=\$(basename \$(ls /run/user/1000/wayland-[0-9] | head -1)); ${*}"
}

function pad() { "${BASEDIR}/bin/qemu-pad" "${@}"; sleep "${PAD_SETTLE:-0.7}"; }
function shot() { sleep "${SHOT_SETTLE:-1}"; "${BASEDIR}/bin/qemu-screenshot" "${STATE}/test-${1}.png" >/dev/null; }

function check() {
    local name="${1}"
    shift
    if "${@}" >/dev/null 2>&1; then
        printf '  \e[32mPASS\e[0m %s\n' "${name}"
        PASS=$((PASS + 1))
    else
        printf '  \e[31mFAIL\e[0m %s\n' "${name}"
        FAIL=$((FAIL + 1))
        FAILED+=("${name}")
    fi
}

function mode_is() { [[ "$(vm cat /run/user/1000/rgos-padd.mode)" == "${1}" ]]; }
function running() { vm pgrep -x "${1}"; }
function not_running() { ! vm pgrep -x "${1}"; }
function screen_is() { [[ "$(gui wlopm | awk '{print $2}' | sort -u)" == "${1}" ]]; }

# Test-time power settings in ~/.config/rgos/power.conf (as a user would):
# lid and power key turn the screen off instead of suspending, because QEMU
# only wakes from s2idle via the RTC alarm (suspend has its own test), and
# no idle timeouts, or the screen goes off during long runs (the idle test
# sets its own).
POWER_TEST_BASE='lid_action=screen-off\npower_key_action=screen-off\ndim_after=0\noff_after=0\nsuspend_after=0\n'
function power_conf() {
    vm "mkdir -p ~/.config/rgos && printf '${POWER_TEST_BASE}${1:-}' > ~/.config/rgos/power.conf"
    gui rgos-power reload
}

function wait_for() {

    for i in $(seq 1 "${2:-20}"); do
        vm pgrep -x "${1}" >/dev/null && return 0
        sleep 0.5
    done
    return 1
}

# Only ever stops this run's own VM
function stop_vm() {
    local pid
    pid="$(qemu_running_pid)" && kill "${pid}" 2>/dev/null
    rm -f "${STATE}/qemu.pid"
}

function finish() {
    [[ "${KEEP}" -eq 1 ]] || stop_vm
    qemu_release
}
trap finish EXIT
# Provision the boot partition like a real card: SSH key + a Wi-Fi network
# ... and a blank second SD card (bin/qemu-sdcard pulls / inserts it)
SDIMG="${STATE}/sdcard.img"
# 4G: big enough for the clone test (head 4M + boot 64M + erofs ~275M +
# overlay 2G + data), sparse so it costs nothing on the host.
rm -f "${SDIMG}" && mkdir -p "${STATE}" && truncate -s 4G "${SDIMG}"

function start_vm() {
    RGOS_WIFI_PASSWORD="test pass 123" "${BASEDIR}/bin/run-qemu" --fresh --headless \
        --key "${BASEDIR}/.ssh/builder.pub" --wifi "Test Net" --country NL --sdcard "${SDIMG}" || exit 1
}

function wait_ssh() {
    for _ in $(seq 1 90); do
        vm true 2>/dev/null && return 0
        sleep 2
    done
    return 1
}

start_vm
log "Waiting for SSH (first boot grows the disk)..."
if ! wait_ssh; then
    # QEMU/HVF can rarely load a truncated initrd: init dies before the
    # first echo (loader error + "Attempted to kill init" in the first
    # fraction of a second). Same image boots fine on retry.
    if grep -q "error while loading shared libraries" "${STATE}/serial.log" 2>/dev/null \
       && grep -q "Attempted to kill init" "${STATE}/serial.log" 2>/dev/null; then
        log "Early boot panic (known QEMU/HVF initrd flake): retrying the boot once"
        stop_vm
        start_vm
        wait_ssh || { log_err "No SSH after 180s (retried once); see ${STATE}/serial.log"; tail -30 "${STATE}/serial.log"; exit 1; }
    else
        log_err "No SSH after 180s; see ${STATE}/serial.log"; tail -30 "${STATE}/serial.log"; exit 1
    fi
fi

power_conf

log "System"
state="$(vm systemctl is-system-running --wait)"
check "system state is running (got: ${state})" test "${state}" = running
failed="$(vm systemctl --failed --no-legend --plain | awk '{print $1}' | tr '\n' ' ')"
check "no failed units ${failed:+(${failed})}" test -z "${failed}"

log "Storage layout (erofs ro root + overlay + /data)"
check "root is an overlayfs" vm 'test "$(findmnt -no FSTYPE /)" = overlay'
check "erofs lower mounted read-only at /mnt/root-ro" vm 'test "$(findmnt -no FSTYPE /mnt/root-ro)" = erofs && findmnt -no OPTIONS /mnt/root-ro | grep -q "^ro"'
check "overlay upper partition ext4 at /mnt/overlay" vm 'test "$(findmnt -no FSTYPE /mnt/overlay)" = ext4'
check "/data is its own ext4 filesystem" vm 'test "$(findmnt -no FSTYPE /data)" = ext4 && test "$(findmnt -no SOURCE /data)" = "/dev/vda4"'
check "/home is a bind from /data/home" vm 'findmnt -no SOURCE /home | grep -q "\[/home\]$"'
check "/etc writable through the overlay" vm 'sudo -n sh -c "echo ok >/etc/.rwtest && grep -q ok /etc/.rwtest && rm /etc/.rwtest"'
check "/var writable through the overlay" vm 'sudo -n sh -c "echo ok >/var/.rwtest && grep -q ok /var/.rwtest && rm /var/.rwtest"'
check "machine-id generated and stable" vm 'test "$(wc -c </etc/machine-id)" = 33'
check "data partition grown on first boot" vm test -f /data/.grown
check "data partition fills the disk" vm 'test "$(lsblk -bno SIZE /dev/vda4)" -gt 4294967296'
check "zram swap active (lzo-rle + zstd recompression)" vm 'swapon --show=NAME --noheadings | grep -q zram0 && grep -q "\[lzo-rle\]" /sys/block/zram0/comp_algorithm && grep -q "zstd" /sys/block/zram0/recomp_algorithm'
check "zram recompress timer enabled" vm 'systemctl is-enabled rgos-zram-recompress.timer'
check "MGLRU enabled at runtime" vm 'test "$(cat /sys/kernel/mm/lru_gen/enabled 2>/dev/null | awk "{print \$1}")" != "0x0000"'
check "locale is valid (no setlocale warnings)" vm 'test -z "$(LANG=en_US.UTF-8 bash -c true 2>&1)"'
check "user can read the journal" vm 'journalctl -b -n1 --no-pager 2>&1 | grep -vq "insufficient permissions"'

log "Security and provisioning"
# We got in with the key provisioned on the boot partition
check "SSH key imported from the boot partition" vm 'test "$(wc -l < /etc/ssh/authorized_keys/user)" -eq 1'
check "sshd: key-only (no password / keyboard / empty logins)" vm 'c="$(sudo sshd -T)"; grep -qxi "passwordauthentication no" <<<"$c" && grep -qxi "kbdinteractiveauthentication no" <<<"$c" && grep -qxi "permitemptypasswords no" <<<"$c" && grep -qxi "authenticationmethods publickey" <<<"$c"'
check "user has no password (local login)" vm 'test -z "$(sudo awk -F: "\$1==\"user\" {print \$2}" /etc/shadow)"'
check "sudo works without password" vm 'sudo -n true'
check "Wi-Fi network imported into iwd" vm 'sudo grep -qx "Passphrase=test pass 123" "/var/lib/iwd/=54657374204e6574.psk"'
check "wifi.txt deleted from the boot partition" vm 'test ! -e /boot/wifi.txt'
check "provisioned Wi-Fi overrides the off default" vm 'test -e /run/rgos/wifi-provisioned && journalctl -b -u rgos-bootconfig --no-pager | grep -q "Wi-Fi switched on"'
check "wifi-imported.txt has no password" vm 'grep -q "Test Net" /boot/wifi-imported.txt && ! grep -q "test pass" /boot/wifi-imported.txt'
check "Wi-Fi country set" vm 'grep -q "ieee80211_regdom=NL" /etc/modprobe.d/rgos-wifi-country.conf'
check "boot partition has README.txt" vm 'grep -q authorized_keys /boot/README.txt'
check "boot report written to the boot partition" vm 'for i in $(seq 1 30); do test -s /boot/rgos-boot.log && exit 0; sleep 2; done; exit 1'
check "/boot automount" vm 'ls /boot/Image'

log "Desktop session"
check "keymap data installed (labwc crashes without)" vm 'test -d /usr/share/X11/xkb/symbols'
check "rgos-session.service active" vm systemctl is-active rgos-session.service
for p in labwc sfwbar swaybg wvkbd-mobintl rgos-padd rgos-padsim rgos-oskd; do
    check "${p} running" wait_for "${p}"
done
check "session LANG is en_US.UTF-8" vm 'grep -qs LANG=en_US.UTF-8 /etc/locale.conf'
check "padd grabbed the simulated pad" vm 'journalctl -b --no-pager | grep -q "rgos-padd: using .*rgos-padsim gamepad"'
check "padd watches the lid" vm 'journalctl -b --no-pager | grep -q "rgos-padsim lid) as lid switch"'
check "padd control FIFO exists" vm 'test -p /run/user/1000/rgos-padd.ctl'
check "oskd detected the QEMU keyboard (stays passive)" vm 'journalctl -b --no-pager | grep -q "rgos-oskd: hardware keyboard: "'
check "pad starts in mouse (pointer) mode" mode_is mouse
check "mode file has no trailing newline (panel label)" vm 'test "$(wc -l < /run/user/1000/rgos-padd.mode)" -eq 0' 
check "app menu lists terminal, files, notes" vm 'm="$(rgos-menu)"; grep -q "<openbox_pipe_menu>" <<<"$m" && grep -q "command=\"foot\"" <<<"$m" && grep -q pcmanfm <<<"$m" && grep -q rgos-notes <<<"$m"'
check "no foot client/server entries in menu" vm '! rgos-menu | grep -q "Foot Client\|Foot Server"'
SHOT_SETTLE=6 shot 01-desktop

log "Main menu (Start)"
# Menu helpers for the fc308fd contract (nav-mode Menu = Close window):
# menu_open: open the root menu, highlight entry $1 (1-based), Enter.
#   Mode-aware: the nav switch only happens from pointer mode; the pad
#   ends in nav mode either way.
# to_pointer: back to pointer mode the way a user does it - the labwc
#   root menu's Power submenu -> "Pointer mode". Index-dependent: root
#   entry 11 = Power, submenu entry 7 = Pointer mode (see menu.xml).
function menu_open() {
    pad tap BTN_START
    [[ "$(vm cat /run/user/1000/rgos-padd.mode 2>/dev/null)" != nav ]] && pad tap BTN_MODE
    for _ in $(seq 1 "${1}"); do pad tap BTN_DPAD_DOWN; done
    pad tap BTN_EAST
}
function to_pointer() {
    [[ "$(vm cat /run/user/1000/rgos-padd.mode 2>/dev/null)" != nav ]] && { pad tap BTN_MODE; sleep 0.4; }
    pad tap BTN_START
    for _ in $(seq 1 11); do pad tap BTN_DPAD_DOWN; done
    pad tap BTN_EAST
    for _ in $(seq 1 7); do pad tap BTN_DPAD_DOWN; done
    pad tap BTN_EAST
    sleep 0.5
}
gui rgos-padctl warp 200 200
pad tap BTN_START
shot 02-menu
# keys mode: arrow down to the first entry (Terminal), Enter
pad tap BTN_MODE
check "Menu tap -> keys mode" mode_is nav
pad tap BTN_DPAD_DOWN
pad tap BTN_EAST
check "Start -> Terminal opens foot" wait_for foot
# fc308fd contract: Menu in nav mode = labwc Close (Super+Q), the exit
# path for fullscreen apps. Pointer mode comes back via the power menu.
pad tap BTN_MODE
check "Menu tap closes the focused foot (Super+Q)" not_running foot
check "pad stays in nav mode after Menu=Close" mode_is nav
check "osk did not auto-open for foot (keyboard attached)" mode_is nav
to_pointer
check "labwc menu's Pointer mode entry returns the pad" mode_is mouse
shot 03-terminal

log "Audio (PipeWire user services)"
check "pipewire user service active" gui 'systemctl --user is-active pipewire'
check "wireplumber user service active" gui 'systemctl --user is-active wireplumber'
check "pipewire-pulse socket up (SDL/mpv compat)" gui 'test -S ${XDG_RUNTIME_DIR}/pulse/native'
check "system-instance pipewire masked (no duplicate server)" vm 'test "$(systemctl is-enabled pipewire.service 2>/dev/null)" = masked'
check "rt limit drop-ins present (rtkit is a roadmap item)" vm 'test -f /etc/systemd/user/pipewire.service.d/50-rgos-rt.conf -a -f /etc/systemd/user/pipewire-pulse.service.d/50-rgos-rt.conf'
check "volume keys path (wpctl default sink)" gui 'rgos-volume up && rgos-volume get | grep -qE "^[0-9]+$"'
check "volume mute toggle" gui 'rgos-volume mute && wpctl get-volume @DEFAULT_AUDIO_SINK@ | grep -q MUTED'

log "Apps (opened from the main menu, like a user would)"
menu_open 2
check "Menu -> Files opens PCManFM" wait_for pcmanfm
shot 04-files
menu_open 3
check "Menu -> Notes opens Mousepad" wait_for mousepad
check "Mousepad settings schema compiled" vm 'gsettings list-schemas | grep -q org.xfce.mousepad'
shot 05-notes
pad tap BTN_TR2
shot 06-next-window
before="$(vm "pgrep -c -x 'foot|pcmanfm|mousepad'")"
pad combo BTN_MODE BTN_SOUTH
sleep 1
after="$(vm "pgrep -c -x 'foot|pcmanfm|mousepad'")"
check "Menu+B closes the focused window (${before} -> ${after})" test "${after}" -lt "${before}"

log "Pointer"
# The apps section leaves the pad in nav mode (menu_open enters it);
# pointer mode is the power-menu entry away.
to_pointer
check "pointer mode before the pointer checks" mode_is mouse
gui rgos-padctl warp 100 100
pad hold BTN_DPAD_RIGHT 600
shot 07-pointer-moved
pad tap BTN_EAST
check "A clicks without breaking the session" running labwc

log "On-screen keyboard"
pad tap BTN_SELECT
check "Select -> keyboard (osk) mode" mode_is osk
pad tap BTN_DPAD_RIGHT BTN_DPAD_RIGHT
shot 08-osk
pad tap BTN_SOUTH
check "B closes it, back to pointer mode" mode_is mouse
gui rgos-padctl osk on
gui rgos-padctl osk on
check "osk on via FIFO (idempotent)" mode_is osk
gui rgos-padctl osk off
check "osk off via FIFO, back to pointer mode" mode_is mouse

log "On-screen keyboard: d-pad jumps key to key"
# Type into a raw terminal: the keyboard opens on "g"; up/down cross the
# staggered rows (ties: up = left key, down = right key)
gui "foot --title osktest sh -c 'stty raw -echo; exec cat > /tmp/osk.txt'" >/dev/null 2>&1 &
sleep 2
gui rgos-padctl osk on
sleep 1
for b in BTN_EAST BTN_DPAD_UP BTN_EAST BTN_DPAD_RIGHT BTN_EAST BTN_DPAD_DOWN BTN_EAST \
         BTN_DPAD_DOWN BTN_EAST BTN_DPAD_DOWN BTN_EAST; do
    PAD_SETTLE=0.3 pad tap "${b}"
done
sleep 0.5
check "keys typed exactly: g t y h b space (got: '$(vm cat /tmp/osk.txt 2>/dev/null)')" vm 'test "$(cat /tmp/osk.txt)" = "gtyhb "'
# From space, 4x left = the layer key; the grid follows wvkbd's layer
for b in BTN_DPAD_LEFT BTN_DPAD_LEFT BTN_DPAD_LEFT BTN_DPAD_LEFT BTN_EAST; do
    PAD_SETTLE=0.3 pad tap "${b}"
done
check "layer key -> padd uses the symbols grid" vm 'journalctl -b --no-pager -o cat | grep -q "rgos-padd: osk layout: landscapespecial$"'
PAD_SETTLE=0.3 pad tap BTN_EAST   # back key, same spot
check "back to the letters grid" vm 'journalctl -b --no-pager -o cat | tail -50 | grep -q "rgos-padd: osk layout: landscape$"'
vm 'kill $(pgrep -a foot | awk "/osktest/ {print \$1}")' 2>/dev/null
gui rgos-padctl osk off

log "Automatic on-screen keyboard (rgos-oskd)"
# Second instance with a test config: keyboard_watch off (ignores the QEMU
# keyboard), foot triggers a marker file instead of touching the pad mode.
vm 'mkdir -p ~/.config/rgos && printf "set apps foot\nset keyboard_watch 0\nset on_show touch /run/user/1000/oskd-test.show\nset on_hide rm -f /run/user/1000/oskd-test.show\n" > ~/.config/rgos/oskd.conf'
vm 'rm -f /run/user/1000/oskd-test.show'
gui 'rgos-oskd >/tmp/oskd-test.log 2>&1 & echo $! > /tmp/oskd-test.pid'
sleep 1
vm 'pkill -x foot'
menu_open 1
check "Start -> Terminal re-opens foot" wait_for foot
check "oskd opens the keyboard when foot activates (no keyboard)" \
    vm 'for i in $(seq 1 10); do test -e /run/user/1000/oskd-test.show && exit 0; sleep 0.5; done; exit 1'
check "oskd logged the decision" vm 'grep -q "window activated.*show" /tmp/oskd-test.log'
vm 'kill "$(cat /tmp/oskd-test.pid)"; rm -f ~/.config/rgos/oskd.conf /tmp/oskd-test.pid'
check "oskd left the pad mode alone (nav after menu_open)" mode_is nav
to_pointer
check "back to pointer for the game-mode checks" mode_is mouse

log "Game mode"
pad combo BTN_MODE BTN_SELECT
check "Menu+Select -> passthrough" mode_is passthrough
pad combo BTN_MODE BTN_SELECT
check "Menu+Select again -> pointer mode" mode_is mouse

log "Power menu"
pad combo BTN_MODE BTN_START
check "Menu+Start opens the power menu" wait_for fuzzel
shot 09-power-menu
pad tap BTN_WEST
check "Esc closes it" not_running fuzzel
# The panel's power button (top right, left of the clock) opens the same menu
gui rgos-padctl warp 569 12
PAD_SETTLE=1 pad tap BTN_EAST
check "panel power button opens the power menu" wait_for fuzzel
shot 09b-power-menu-panel
check "power menu offers Suspend" vm 'grep -q "\"Suspend\"" /usr/bin/rgos-power-menu'
pad tap BTN_WEST
check "Esc closes it" not_running fuzzel

log "Screen, lid, keys"
power_conf
pad tap KEY_VOLUMEUP
check "volume key handled (session still up)" running labwc
check "volume key shows an on-screen popup (mako)" gui 'makoctl list | grep -q "Volume"'
pad lid close
sleep 1.5
check "lid close turns the screen off" screen_is off
pad lid open
sleep 1.5
check "lid open turns the screen back on" screen_is on
pad tap KEY_POWER
sleep 1.5
check "power key turns the screen off" screen_is off
pad tap KEY_POWER
sleep 1.5
check "power key turns it back on" screen_is on
shot 10-final

log "Power (rgos-power)"
check "rgos-power status works" vm 'rgos-power status | grep -q "^profile"'
check "panel line (no battery in QEMU -> AC)" vm 'test "$(rgos-power panel)" = AC'
check "idle daemon running (rgos-idle + swayidle)" wait_for swayidle
check "battery guard running" vm 'systemctl is-active rgos-battery-guard.service'
# Low-battery warning: mock a discharging battery, run single guard passes
vm 'mkdir -p /tmp/psu/bat0 && echo Battery > /tmp/psu/bat0/type && echo 9 > /tmp/psu/bat0/capacity && echo Discharging > /tmp/psu/bat0/status && sudo -n rm -f /run/rgos-battery-warned'
vm 'sudo -n /usr/libexec/rgos/battery-guard --once --psu-dir /tmp/psu'
# mako registration is async; retry briefly before calling it a fail
lowbat_ok=0
for _ in $(seq 1 10); do gui 'makoctl list | grep -q "Battery low"' && lowbat_ok=1 && break; sleep 0.5; done
check "low battery -> warning notification" test "${lowbat_ok}" = 1
shot 11-battery-notification
gui 'makoctl dismiss -a'
vm 'sudo -n /usr/libexec/rgos/battery-guard --once --psu-dir /tmp/psu'
check "warning fires once per discharge (no repeat)" gui '! makoctl list | grep -q "Battery low"'
vm 'echo Charging > /tmp/psu/bat0/status && sudo -n /usr/libexec/rgos/battery-guard --once --psu-dir /tmp/psu'
check "charger re-arms the warning" vm 'sudo -n test ! -e /run/rgos-battery-warned'
# Device-bug regression (AXP717): a FULL battery on AC reports the
# two-word status "Not charging". The guard must treat it as
# not-discharging (no low-battery warning); rgos-power joins the words
# internally (battery_read one-word contract, device crash fix).
vm 'echo "Not charging" > /tmp/psu/bat0/status && echo 100 > /tmp/psu/bat0/capacity && sudo -n rm -f /run/rgos-battery-warned'
check "battery-guard: 'Not charging' at 100% -> no warning, no crash" vm 'sudo -n /usr/libexec/rgos/battery-guard --once --psu-dir /tmp/psu && sudo -n test ! -e /run/rgos-battery-warned'
check "rgos-power joins multi-word battery statuses (fix in place)" vm 'grep -q "status=\"\${status// /_}\"" /usr/bin/rgos-power'
vm 'sudo -n rm -rf /tmp/psu /run/rgos-battery-warned'
check "sleep hook installed" vm 'test -x /usr/lib/systemd/system-sleep/rgos-power.sh'
check "ac-profile is a no-op without profile_ac" vm 'sudo -n /usr/libexec/rgos/ac-profile'
check "writable ext4 mounts are noatime,commit=60 (fewer SD writes)" vm 'findmnt -no OPTIONS /data | grep -q "noatime.*commit=60" && findmnt -no OPTIONS /mnt/overlay | grep -q "noatime.*commit=60"'
check "journald: no debug on disk, 15 min sync" vm 'grep -q "^SyncIntervalSec=15m" /usr/lib/systemd/journald.conf.d/50-rgos-power.conf'
check "dirty writeback every 15 s" vm 'test "$(sysctl -n vm.dirty_writeback_centisecs)" = 1500'
check "panic -> reboot after 20 s (safety net)" vm 'test "$(sysctl -n kernel.panic)" = 20'
check "inotify limits raised" vm 'test "$(sysctl -n fs.inotify.max_user_instances)" = 1024 && test "$(sysctl -n fs.inotify.max_user_watches)" = 524288'
check "profile battery -> balanced" gui 'rgos-power profile battery && test "$(rgos-power profile)" = battery && rgos-power profile balanced && test "$(rgos-power profile)" = balanced'
check "mDNS enabled (rgos.local)" vm 'resolvectl status | grep -qi "MulticastDNS setting: yes\|+mDNS"'
# Power key: three rapid events must toggle the screen once (no flashing)
gui 'for i in 1 2 3; do rgos-power event power-key & done; wait'
sleep 1.5
check "rapid power-key events -> screen off once (no flashing)" screen_is off
gui 'sleep 1.1; rgos-power event power-key'
sleep 1.5
check "power key with screen off wakes it" screen_is on
# Idle: shorten the screen-off timeout, then a pad press wakes it
power_conf 'dim_after=0\noff_after=4\nsuspend_after=0\n'
sleep 8
check "idle -> screen off after off_after (config override)" screen_is off
pad tap BTN_WEST
sleep 1.5
check "pad press wakes the screen" screen_is on
power_conf
power_conf

log "Apps: command line"
for c in "rg --version" "fd --version" "bat --version" "zoxide --version" "tldr --version" \
         "fzf --version" "glow --version" "btop --version" "progress --version" "prettyping --help" \
         "yq --version" "jq --version" "git --version" "python3 -c 'import ssl, sqlite3, curses'" \
         "mc --version" "ncdu --version" "tree --version" "7za i" "sqlite3 --version" "gpg --version" \
         "nmap --version" "mtr --version" "iperf3 --version" "tcpdump --version" "strace -V" \
         "lsof -v" "nc -h" "minicom --version" "weechat --version" "mpv --version" "yt-dlp --version" "qjs -h" \
         "rtl_test -h" "rtl_433 -V" "dump1090 --help" "SoapySDRUtil --info"; do
    check "${c%% *} runs" vm "${c} </dev/null >/dev/null 2>&1 || [ \$? -lt 126 ]"
done
check "login shell has z (zoxide) and fzf bindings" vm 'bash -lic "type z && bind -X | grep -q fzf"'
check "UTF-8 ncurses (wide) for mc/WeeChat" vm 'ls /usr/lib/libncursesw.so.6'
check "glibc charset converters (gconv) installed" vm 'test -f /usr/lib/gconv/CP1252.so && test -f /usr/lib/gconv/gconv-modules'
check "yt-dlp uses QuickJS (system config)" vm 'grep -q "js-runtimes quickjs" /etc/yt-dlp.conf'
check "yt-dlp updater present (menu + helper)" vm 'test -x /usr/libexec/rgos/ytupdate && test -f /usr/share/applications/rgos-ytupdate.desktop'
check "yt-dlp update installs to /usr/local/bin" vm 'sudo -n /usr/libexec/rgos/ytupdate >/dev/null 2>&1 && /usr/local/bin/yt-dlp --version'

log "Apps: desktop"
for app in geany netsurf-gtk3 srain mpv:--idle=yes,--force-window=yes; do
    bin="${app%%:*}" args="${app#*:}"; [[ "${args}" == "${app}" ]] && args=""; args="${args//,/ }"
    gui "${bin} ${args} >/dev/null 2>&1 &"
    check "${bin} opens a window" wait_for "${bin}" 20
    sleep 3
    check "${bin} still running after 3 s" running "${bin}"
    shot "apps-${bin}"
    vm "pkill -x ${bin}"
    sleep 1
done
before_rockbox="$(vm cat /run/user/1000/rgos-padd.mode)"
gui "setsid -f rgos-rockbox >/dev/null 2>&1"
check "Rockbox starts" wait_for rockbox 20
sleep 4
check "Rockbox still running" running rockbox
check "Rockbox config: starts in a music folder" vm 'grep -q "^start directory: .*Music/" ~/.config/rockbox.org/config.cfg'
check "pad in nav mode while Rockbox runs" mode_is nav
shot apps-rockbox
PAD_SETTLE=1 pad tap BTN_SOUTH   # B = back (to the main menu)
# Menu (tap) closes the focused window: the exit path for nav apps
# (Rockbox's sdlapp build has no Quit item of its own)
PAD_SETTLE=1 pad tap BTN_MODE
for _ in $(seq 1 20); do vm pgrep -x rockbox >/dev/null || break; sleep 0.5; done
check "Rockbox exits via Menu (labwc Close, Super+Q)" not_running rockbox
vm 'pkill -x rockbox 2>/dev/null || true'
# Rockbox saves its settings on exit; the launcher restores the mode after
for _ in $(seq 1 10); do mode_is "${before_rockbox}" && break; sleep 0.5; done
check "pad mode restored after Rockbox (${before_rockbox})" mode_is "${before_rockbox}"
# WebKit browser (QEMU evaluation build only): opens and renders a page
if vm 'command -v rgos-web' >/dev/null 2>&1; then
    gui "setsid -f rgos-web file:///usr/share/rgos/webtest.html >/dev/null 2>&1"
    check "WebKit browser starts (MiniBrowser)" wait_for MiniBrowser 30
    sleep 8
    check "WebKit web process runs (page loaded)" vm 'pgrep -f WebKitWebProcess'
    shot apps-webkit
    check "WebKit browser RAM < 600 MB (MiniBrowser + web process; 400 failed: 506 measured, device decides)" vm 'test "$(ps -C MiniBrowser,WebKitWebProcess,WebKitNetworkProcess -o rss= | awk "{s+=\$1} END {print int(s/1024)}")" -lt 600'
    vm 'pkill -x MiniBrowser'
fi
check "YouTube app in the menu" vm 'test -f /usr/share/applications/rgos-youtube.desktop'
check "Geany in the menu" vm 'test -f /usr/share/applications/geany.desktop'
check "Srain in the menu" vm 'test -f /usr/share/applications/im.srain.Srain.desktop'

# Syncthing ships disabled by default; enabling is an explicit user action
check "syncthing binary runs (stamped v${SYNCTHING_VERSION:-2.1.6})" vm 'syncthing --version 2>/dev/null | head -n1 | grep -q "syncthing v2\.1\.6"'
check "syncthing user unit installed" vm 'test -f /usr/lib/systemd/user/syncthing.service'
check "syncthing disabled by default (no wants symlinks)" vm 'test ! -e ~/.config/systemd/user/default.target.wants/syncthing.service && test ! -e /etc/systemd/user/default.target.wants/syncthing.service'
check "syncthing enables on request" vm 'DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus systemctl --user enable --now syncthing.service'
check "syncthing runs once enabled" wait_for "syncthing" 20
vm 'DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus systemctl --user disable --now syncthing.service'
check "syncthing stops + stays disabled after disable --now" vm 'test ! -e ~/.config/systemd/user/default.target.wants/syncthing.service && ! pgrep -x syncthing'

log "Emulators"
check "retroarch binary runs" vm 'retroarch --version 2>/dev/null | grep -q "^RetroArch"'
for core in gambatte mgba nestopia snes9x genesis_plus_gx; do
    check "core installed (${core})" vm "ls /usr/lib/libretro/${core}_libretro.so"
done
check "rgos-game launcher installed" vm 'test -x /usr/bin/rgos-game'
check "games + background slices (user units)" vm 'test -f /usr/lib/systemd/user/games.slice && test -f /usr/lib/systemd/user/background.slice'
check "system.slice memory floor drop-in" vm 'test -f /etc/systemd/system/system.slice.d/50-rgos-memory.conf'
check "retroarch defaults config shipped" vm 'test -f /etc/rgos/retroarch.cfg.defaults'
check "RetroArch in the menu" vm 'test -f /usr/share/applications/retroarch.desktop'
before_ra="$(vm cat /run/user/1000/rgos-padd.mode)"
gui "setsid -f rgos-game retroarch >/dev/null 2>&1"
check "retroarch starts via rgos-game" wait_for retroarch 30
check "pad in passthrough mode while running" mode_is passthrough
check "games.slice active while running" vm 'DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus systemctl --user is-active games.slice'
check "Mesa copy-image override in the game env" vm 'tr "\0" "\n" </proc/$(pgrep -x retroarch)/environ | grep -q "MESA_EXTENSION_OVERRIDE=-GL_OES_copy_image"'
sleep 5
check "retroarch still running after 5 s (menu)" running retroarch
shot emu-retroarch-menu
vm 'pkill -x retroarch'
for _ in $(seq 1 10); do mode_is "${before_ra}" && break; sleep 0.5; done
# Core + content run: hand-crafted public-domain test ROM (valid header,
# no MBC, infinite loop), built on the guest from zeros + header bytes
vm 'rom=/tmp/rgos-test.gb; head -c 32768 /dev/zero >"$rom"; printf "\x00\xc3\x50\x01" | dd of="$rom" bs=1 seek=256 conv=notrunc 2>/dev/null; printf "RGOSTEST" | dd of="$rom" bs=1 seek=308 conv=notrunc 2>/dev/null; printf "\x33" | dd of="$rom" bs=1 seek=331 conv=notrunc 2>/dev/null; printf "\x38" | dd of="$rom" bs=1 seek=333 conv=notrunc 2>/dev/null; printf "\x03\xfb" | dd of="$rom" bs=1 seek=334 conv=notrunc 2>/dev/null; printf "\x76\x18\xfe" | dd of="$rom" bs=1 seek=336 conv=notrunc 2>/dev/null'
gui "setsid -f rgos-game retroarch -L /usr/lib/libretro/gambatte_libretro.so /tmp/rgos-test.gb >/dev/null 2>&1"
check "core run starts (gambatte + test ROM)" wait_for retroarch 30
sleep 5
check "core run still alive after 5 s" running retroarch
shot emu-retroarch-gambatte
vm 'pkill -x retroarch'
for _ in $(seq 1 10); do mode_is "${before_ra}" && break; sleep 0.5; done
check "pad mode restored after exit (${before_ra})" mode_is "${before_ra}"

log "Second SD card"
card="$(vm "lsblk -dno NAME | grep '^mmcblk' | head -n1")"
check "blank card detected (${card:-none})" test -n "${card}"
check "blank card: not usable, warning icon" vm 'grep -q "^unusable" /run/rgos/sdcard && grep -q warning /run/rgos/sdcard.icon'
vm "sudo -n /usr/libexec/rgos/sdcard format ${card}" >/dev/null 2>&1
check "format: exFAT RGOS-DATA at /media/sdcard" vm 'test "$(findmnt -no FSTYPE /media/sdcard)" = exfat && test "$(lsblk -no LABEL "$(findmnt -no SOURCE /media/sdcard)")" = RGOS-DATA'
check "standard folders, owned by user" vm 'cd /media/sdcard && test -d Music -a -d Videos -a -d Pictures -a -d Documents -a -d Downloads && test "$(stat -c %U Music)" = user'
check "~/SD link: user writes to the card" vm 'echo hello > ~/SD/Documents/test.txt && grep -q hello /media/sdcard/Documents/test.txt'
check "file manager bookmark" vm 'grep -q "file:///media/sdcard" ~/.config/gtk-3.0/bookmarks'
check "panel icon: SD card" vm 'grep -q media-flash /run/rgos/sdcard.icon'
check "notification daemon (mako) running" running mako
shot 11-sdcard
vm "sudo -n systemctl stop rgos-sdcard@${card}p1.service"
check "Eject: unmounted, state ejected" vm '! mountpoint -q /media/sdcard && grep -q "^ejected" /run/rgos/sdcard'
vm "sudo -n systemctl restart rgos-sdcard@${card}p1.service"
check "Mount again: file still there" vm 'grep -q hello /media/sdcard/Documents/test.txt'
"${BASEDIR}/bin/qemu-sdcard" eject
sleep 3
check "card pulled while mounted: unmounted, no state" vm '! mountpoint -q /media/sdcard && test ! -e /run/rgos/sdcard'
"${BASEDIR}/bin/qemu-sdcard" insert "${SDIMG}"
# Generous wait: with heavy host I/O next door (e.g. a concurrent Buildroot
# build on the same Mac) the emulated SDHCI card-detect can need well over
# 30 s; seen once, never reproduced in isolation (~1 s normally).
for _ in $(seq 1 180); do vm 'mountpoint -q /media/sdcard' && break; sleep 0.5; done
check "card inserted: checked and mounted again, file there" vm 'mountpoint -q /media/sdcard && grep -q hello /media/sdcard/Documents/test.txt'

log "Second SD card: clone, backup, /data/config"
# Clone: raw-copy the running system onto the second card (OS only).
vm "sudo -n /usr/libexec/rgos/sdcard clone ${card}" >/dev/null 2>&1
check "clone: four partitions on the second card" vm "lsblk -nlo NAME /dev/${card} | grep -c '${card}p[1-4]\$' | grep -q 4"
check "clone: boot partition is RGOS-BOOT FAT" vm "test \"\$(blkid -o value -s LABEL /dev/${card}p1)\" = RGOS-BOOT && test \"\$(blkid -o value -s TYPE /dev/${card}p1)\" = vfat"
check "clone: erofs root on p2" vm "test \"\$(blkid -p -o value -s TYPE /dev/${card}p2)\" = erofs"
check "clone: p4 resized to fill the card" vm "test \$(lsblk -nlo SIZE /dev/${card}p4) != \$(lsblk -nlo SIZE /dev/${card}p3)"
check "clone: card recognised as an RGOS system card" vm 'grep -q "^system" /run/rgos/sdcard'
# Backup/restore of personal data needs a usable card again
vm "sudo -n /usr/libexec/rgos/sdcard format ${card}" >/dev/null 2>&1
for _ in $(seq 1 60); do vm 'mountpoint -q /media/sdcard' && break; sleep 0.5; done
vm "sudo -n /usr/libexec/rgos/sdcard backup ${card} data" >/dev/null 2>&1
check "backup: data archive on the card" vm 'ls /media/sdcard/rgos-data-*.tar.gz >/dev/null 2>&1'
bak="$(vm 'ls /media/sdcard/rgos-data-*.tar.gz 2>/dev/null | tail -n1')"
check "backup: archive lists /data/home and overlay upper" vm "tar -tzf '${bak}' | grep -q 'data/home/' && tar -tzf '${bak}' | grep -q 'overlay/upper/'"
vm "sudo -n /usr/libexec/rgos/sdcard restore ${card} '${bak}'" >/dev/null 2>&1
check "restore: data archive unpacks without error" vm "sudo -n tar -tzf '${bak}' >/dev/null 2>&1"
check "/data/config overrides /etc/rgos (middle layer)" vm 'echo "warn_percent=42" | sudo -n tee /data/config/power.conf >/dev/null && test "$(rgos-power-conf warn_percent 10)" = 42 && sudo -n rm /data/config/power.conf'
check "config layer falls back to /etc/rgos" vm 'test "$(rgos-power-conf warn_percent 10)" = 10'

log "Suspend (last: QEMU's display stays blank after s2idle)"
# Suspend (s2idle) through rgos-power, woken by an RTC alarm 6 s later.
# suspend_mode is written to /etc: the sleep hook runs as root and does not
# see the user's overrides. QEMU's PSCI SYSTEM_SUSPEND would exit the VM
# instead of waking, so pin s2idle regardless of what auto would pick.
vm 'sudo -n sh -c "echo suspend_mode=s2idle >> /etc/rgos/power.conf"'
vm 'sudo -n sh -c "echo 0 > /sys/class/rtc/rtc0/wakealarm; echo +6 > /sys/class/rtc/rtc0/wakealarm"'
gui 'rgos-power suspend' &
sleep 15
wait
check "suspend (s2idle via sleep hook) and resume via RTC alarm" vm 'journalctl -b --no-pager -o cat | grep -q "PM: suspend exit"'
check "hook selected s2idle" vm 'journalctl -b --no-pager -o cat | grep -q "PM: suspend entry (s2idle)"'
check "desktop alive after resume" running labwc
check "screen on after resume" screen_is on
check "padd alive after resume" running rgos-padd

log "Stability"
check "nothing crashed (no core dumps this boot)" vm '! journalctl -b --no-pager -o cat | grep -q "dumped core"'
check "desktop session never restarted" vm 'test "$(systemctl show -p NRestarts --value rgos-session.service)" = 0'

log "Logs"
errors="$(vm journalctl -b -p err --no-pager -o cat | sort | uniq -c | sort -rn | head -15)"
if [[ -n "${errors}" ]]; then
    log_dim "journal errors (not counted as failures):"
    printf '%s\n' "${errors}" | sed 's/^/      /'
fi
session_warnings="$(vm journalctl -b -u rgos-session --no-pager -o cat | grep -iE 'error|warn|fail' | sort | uniq -c | sort -rn | head -15)"
if [[ -n "${session_warnings}" ]]; then
    log_dim "desktop session warnings (not counted as failures):"
    printf '%s\n' "${session_warnings}" | sed 's/^/      /'
fi

echo
log "${PASS} passed, ${FAIL} failed — screenshots in ${STATE}/test-*.png"
for f in "${FAILED[@]}"; do log_err "${f}"; done
[[ "${KEEP}" -eq 1 ]] && log "VM left running (instance ${QEMU_INSTANCE}): ssh -p ${QEMU_SSH_PORT} user@localhost, pad: RGOS_QEMU_INSTANCE=${QEMU_INSTANCE} bin/qemu-pad, stop: kill \$(cat ${STATE}/qemu.pid)"
[[ "${FAIL}" -eq 0 ]]
