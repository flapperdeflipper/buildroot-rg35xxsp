#!/usr/bin/env python3
"""Drive the simulated RG35XX SP controls of a running bin/run-qemu VM.

Interactive (keys in this terminal become handheld buttons):
    bin/qemu-pad

Scripted (for tests):
    bin/qemu-pad tap BTN_START [BTN_EAST ...]   press + release each
    bin/qemu-pad press BTN_MODE                 hold down
    bin/qemu-pad release BTN_MODE
    bin/qemu-pad combo BTN_MODE BTN_SELECT      hold first, tap the rest
    bin/qemu-pad hold BTN_DPAD_RIGHT 800        hold for N ms
    bin/qemu-pad lid close|open

Button names: BTN_EAST (A) BTN_SOUTH (B) BTN_NORTH (X) BTN_WEST (Y)
BTN_DPAD_UP/DOWN/LEFT/RIGHT BTN_TL/TR (L1/R1) BTN_TL2/TR2 (L2/R2)
BTN_SELECT BTN_START BTN_MODE (Menu) KEY_VOLUMEUP KEY_VOLUMEDOWN KEY_POWER
"""

import os
import select
import socket
import sys
import termios
import time
import tty

BASE = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..")
# QEMU instance (bin/lib/qemu.sh): RGOS_QEMU_INSTANCE=N -> tmp/qemu-N
_INSTANCE = int(os.environ.get("RGOS_QEMU_INSTANCE") or 0)
STATE = os.path.join(BASE, "tmp", "qemu" if _INSTANCE == 0 else f"qemu-{_INSTANCE}")
SOCK = os.path.join(STATE, "pad.sock")
TAP_MS = 80

KEYMAP = {
    "\x1b[A": "BTN_DPAD_UP", "\x1b[B": "BTN_DPAD_DOWN",
    "\x1b[D": "BTN_DPAD_LEFT", "\x1b[C": "BTN_DPAD_RIGHT",
    "a": "BTN_EAST", "b": "BTN_SOUTH", "x": "BTN_NORTH", "y": "BTN_WEST",
    "q": "BTN_TL", "e": "BTN_TR", "1": "BTN_TL2", "3": "BTN_TR2",
    "\r": "BTN_START", "s": "BTN_SELECT", "m": "BTN_MODE",
    "+": "KEY_VOLUMEUP", "=": "KEY_VOLUMEUP", "-": "KEY_VOLUMEDOWN", "p": "KEY_POWER",
}

HELP = """\
RGOS pad  —  arrows: d-pad   a b x y: A B X Y   q e: L1 R1   1 3: L2 R2
             Enter: Start   s: Select   m: Menu (tap)   M: hold/release Menu
             + -: volume    p: power    l: lid close/open   Ctrl-C: quit
"""


def connect():
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        s.connect(SOCK)
    except OSError as err:
        sys.exit(f"qemu-pad: cannot connect to {SOCK}: {err} (is bin/run-qemu running?)")
    return s


def send(s, code, value):
    s.sendall(f"{code} {value}\n".encode())


def tap(s, code, ms=TAP_MS):
    send(s, code, 1)
    time.sleep(ms / 1000)
    send(s, code, 0)


def interactive():
    s = connect()
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    menu_held = False
    lid_closed = False
    print(HELP)
    try:
        tty.setraw(fd)
        while True:
            ch = os.read(fd, 1).decode(errors="ignore")
            if ch == "\x1b":
                # Arrow keys arrive as ESC [ A..D
                if select.select([fd], [], [], 0.02)[0]:
                    ch += os.read(fd, 2).decode(errors="ignore")
            if ch in ("\x03", "\x04"):
                break
            if ch == "M":
                menu_held = not menu_held
                send(s, "BTN_MODE", 1 if menu_held else 0)
                status = "Menu HELD" if menu_held else "Menu released"
            elif ch == "l":
                lid_closed = not lid_closed
                send(s, "SW_LID", 1 if lid_closed else 0)
                status = "lid closed" if lid_closed else "lid open"
            elif ch in KEYMAP:
                tap(s, KEYMAP[ch])
                status = KEYMAP[ch]
            else:
                continue
            sys.stdout.write(f"\r\x1b[K{status}{'  [Menu held]' if menu_held and ch != 'M' else ''}")
            sys.stdout.flush()
    finally:
        if menu_held:
            send(s, "BTN_MODE", 0)
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
        print()


def scripted(cmd, args):
    s = connect()
    if cmd == "tap":
        for code in args:
            tap(s, code)
            time.sleep(0.05)
    elif cmd == "press":
        for code in args:
            send(s, code, 1)
    elif cmd == "release":
        for code in args:
            send(s, code, 0)
    elif cmd == "combo":
        send(s, args[0], 1)
        time.sleep(0.05)
        for code in args[1:]:
            tap(s, code)
        time.sleep(0.05)
        send(s, args[0], 0)
    elif cmd == "hold":
        tap(s, args[0], int(args[1]))
    elif cmd == "lid":
        send(s, "SW_LID", 1 if args[0] == "close" else 0)
    else:
        sys.exit(__doc__)
    # Give rgos-padsim time to read before we hang up
    time.sleep(0.1)
    s.close()


if __name__ == "__main__":
    if len(sys.argv) == 1:
        interactive()
    elif sys.argv[1] in ("-h", "--help"):
        print(__doc__)
    else:
        scripted(sys.argv[1], sys.argv[2:])
