#!/usr/bin/env python3
"""Screenshot the display of a running bin/run-qemu VM (via QMP).

    bin/qemu-screenshot [file.png]      default: tmp/qemu/screenshot.png
"""

import json
import os
import socket
import sys

BASE = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..")
SOCK = os.path.join(BASE, "tmp", "qemu", "qmp.sock")


def qmp(sock_file, command, **arguments):
    msg = {"execute": command}
    if arguments:
        msg["arguments"] = arguments
    sock_file.write(json.dumps(msg) + "\n")
    sock_file.flush()
    while True:
        reply = json.loads(sock_file.readline())
        if "return" in reply:
            return reply["return"]
        if "error" in reply:
            sys.exit(f"qemu-screenshot: {reply['error'].get('desc')}")
        # skip asynchronous events


def main():
    if len(sys.argv) > 1 and sys.argv[1] in ("-h", "--help"):
        sys.exit(__doc__)
    out = os.path.abspath(sys.argv[1] if len(sys.argv) > 1 else os.path.join(BASE, "tmp", "qemu", "screenshot.png"))
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        s.connect(SOCK)
    except OSError as err:
        sys.exit(f"qemu-screenshot: cannot connect to {SOCK}: {err} (is bin/run-qemu running?)")
    f = s.makefile("rw")
    json.loads(f.readline())  # greeting
    qmp(f, "qmp_capabilities")
    qmp(f, "screendump", filename=out, format="png")
    print(out)


if __name__ == "__main__":
    main()
