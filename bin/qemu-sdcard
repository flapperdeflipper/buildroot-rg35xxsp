#!/usr/bin/env python3
"""Pull or insert the second SD card of a running bin/run-qemu VM (via QMP).
The VM must be started with --sdcard.

    bin/qemu-sdcard eject              pull the card
    bin/qemu-sdcard insert <file.img>  insert a (raw image) card
"""

import json
import os
import socket
import sys

BASE = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..")
# QEMU instance (bin/lib/qemu.sh): RGOS_QEMU_INSTANCE=N -> tmp/qemu-N
_INSTANCE = int(os.environ.get("RGOS_QEMU_INSTANCE") or 0)
STATE = os.path.join(BASE, "tmp", "qemu" if _INSTANCE == 0 else f"qemu-{_INSTANCE}")
SOCK = os.path.join(STATE, "qmp.sock")
DEVICE = "sdcard0"  # id of the sd-card device in bin/run-qemu


def qmp(sock_file, command, **arguments):
    msg = {"execute": command}
    if arguments:
        msg["arguments"] = arguments
    sock_file.write(json.dumps(msg) + "\n")
    sock_file.flush()
    while True:
        reply = json.loads(sock_file.readline())
        if "return" in reply:
            return reply["return"]
        if "error" in reply:
            sys.exit(f"qemu-sdcard: {reply['error'].get('desc')}")
        # skip asynchronous events


def main():
    if len(sys.argv) < 2 or sys.argv[1] not in ("eject", "insert") or (
            sys.argv[1] == "insert" and len(sys.argv) < 3):
        sys.exit(__doc__)
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        s.connect(SOCK)
    except OSError as err:
        sys.exit(f"qemu-sdcard: cannot connect to {SOCK}: {err} (is bin/run-qemu running?)")
    f = s.makefile("rw")
    json.loads(f.readline())  # greeting
    qmp(f, "qmp_capabilities")
    if sys.argv[1] == "eject":
        qmp(f, "eject", id=DEVICE, force=True)
    else:
        qmp(f, "blockdev-change-medium", id=DEVICE,
            filename=os.path.abspath(sys.argv[2]), format="raw")


if __name__ == "__main__":
    main()
